NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_FOOTBALL_DATA_API_KEY=your_football_data_key_optional
NEXT_PUBLIC_ADMIN_PIN=2026

# Server-only (set in Vercel project env, never with a NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
FOOTBALL_DATA_API_KEY=your_football_data_key

# Daily Wrap (auto-generated digests, stored in audit_log — no extra table needed)
# Optional. If set, it locks down /api/sync-scores and /api/bulletin/generate;
# leave UNSET to let the daily GitHub Actions cron call them with no secret.
CRON_SECRET=

# WhatsApp Cloud API (optional — enables the "wrap is live" push to the admin's phone)
WHATSAPP_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id
