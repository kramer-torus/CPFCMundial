NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_FOOTBALL_DATA_API_KEY=your_football_data_key_optional
NEXT_PUBLIC_ADMIN_PIN=2026

# Server-only (set in Vercel project env, never with a NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
FOOTBALL_DATA_API_KEY=your_football_data_key

# Bulletins (auto-generated WhatsApp digests)
# Shared secret protecting /api/sync-scores and /api/bulletin/generate from public hits.
CRON_SECRET=a_long_random_string
# Anthropic API key — powers the banter generation. Without it, bulletins fall back to a plain template.
ANTHROPIC_API_KEY=sk-ant-...

# WhatsApp Cloud API (optional — enables the "bulletin ready" push to the admin's phone)
WHATSAPP_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id
